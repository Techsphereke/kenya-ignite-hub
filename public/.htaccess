<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect social media crawlers to the OG function for article pages.
  # Use an external redirect instead of Apache proxying because many cPanel hosts
  # disable or break proxy passthrough, which causes 503 responses to crawlers.
  RewriteCond %{HTTP_USER_AGENT} facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Discordbot|Google-Structured-Data-Testing-Tool|Googlebot|vkShare|PinterestBot|Viber|SkypeUriPreview|redditbot|Tumblr|Mastodon|Embedly|Quora\ Link\ Preview|Iframely|outbrain|W3C_Validator [NC]
  RewriteCond %{REQUEST_URI} ^/article/(.+)$ [NC]
  RewriteRule ^article/(.+)$ https://fxnlvjbuyxzjpmlvjfmh.supabase.co/functions/v1/og-article?slug=$1 [R=302,L,QSA,B]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
